<Project>
  <PropertyGroup>
    <Ara3DVersion>1.6.1</Ara3DVersion>
    <Version Condition="'$(Version)' == ''">$(Ara3DVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Ara3DVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Ara3DVersion)</FileVersion>
    <AssemblyFileVersion Condition="'$(AssemblyFileVersion)' == ''">$(Ara3DVersion)</AssemblyFileVersion>

    <Authors Condition="'$(Authors)' == ''">Ara 3D Inc.</Authors>
    <Company Condition="'$(Company)' == ''">Ara 3D Inc.</Company>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/ara3d/bim-open-data</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/ara3d/bim-open-data</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Every dependency is built from deps\<name>, which deps.mjs fills with every
    repository the build reaches, cloned or linked to a sibling checkout. When
    this repository is itself a dependency (bim-open-toolkit/deps/bim-open-data:
    its folder sits in a folder named deps that holds a .deps-root marker),
    that deps folder is used instead, so its projects reach bim-open-schema and
    ara3d-sdk by the same paths as the host's projects and solution do, and
    MSBuild sees one project, not two. Paths are kept as written, never
    resolved through a link. bim-open-flow's Directory.Build.props states the
    same rule.
  -->
  <PropertyGroup>
    <_DepsParent>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_DepsParent>
    <_DepsParentName>$([System.IO.Path]::GetFileName('$(_DepsParent)'))</_DepsParentName>
    <DepsRoot Condition="'$(DepsRoot)' == '' And '$(_DepsParentName)' == 'deps' And Exists('$(_DepsParent)\.deps-root')">$(_DepsParent)\</DepsRoot>
    <DepsRoot Condition="'$(DepsRoot)' == ''">$(MSBuildThisFileDirectory)deps\</DepsRoot>
  </PropertyGroup>

  <!-- Keep in step with bim-open-toolkit's Directory.Build.props: both build these projects. -->
  <PropertyGroup Label="Central NuGet dependency versions">
    <Ara3DSdkVersion>1.6.1</Ara3DSdkVersion>
    <Ara3DClosedXmlVersion>0.105.0</Ara3DClosedXmlVersion>
    <Ara3DCoverletCollectorVersion>6.0.0</Ara3DCoverletCollectorVersion>
    <!-- Equal to the flatc that generated Ara3D.BimOpenSchema.IO.Fragments/Schema: the generated code checks it. -->
    <Ara3DGoogleFlatBuffersVersion>25.2.10</Ara3DGoogleFlatBuffersVersion>
    <Ara3DDuckDbNetDataFullVersion>1.3.2</Ara3DDuckDbNetDataFullVersion>
    <Ara3DMicrosoftDataSqliteVersion>8.0.6</Ara3DMicrosoftDataSqliteVersion>
    <Ara3DMicrosoftNetTestSdkVersion>17.8.0</Ara3DMicrosoftNetTestSdkVersion>
    <Ara3DNewtonsoftJsonVersion>13.0.3</Ara3DNewtonsoftJsonVersion>
    <Ara3DNUnitAnalyzersVersion>3.9.0</Ara3DNUnitAnalyzersVersion>
    <Ara3DNUnitVersion>3.14.0</Ara3DNUnitVersion>
    <Ara3DNUnit3TestAdapterVersion>4.5.0</Ara3DNUnit3TestAdapterVersion>
    <Ara3DParquetNetVersion>5.2.0</Ara3DParquetNetVersion>
  </PropertyGroup>
</Project>
