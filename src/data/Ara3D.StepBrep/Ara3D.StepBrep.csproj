<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ara3D.StepBrep</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Benign in Plato's output: hidden members, == without Equals overrides, undocumented members. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0660;CS0661;CS1591</NoWarn>
    <!-- The runtime's parts that name the stdlib's concept interfaces, which Generated/ declares. -->
    <DefineConstants>$(DefineConstants);PLATO_FORWARD_CONCEPTS</DefineConstants>
    <Description>The Plato STEP B-rep library (bim-open-toolkit sandbox/step-brep-mesh, layers 00 to 07) compiled to C# by Plato: BrepModel, RawDecodedModel, PrepareModel, the witnesses and the laws. Generated by tools/regen-step-brep.ps1; Number is binary64.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ara3D.Collections" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

</Project>
