<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Ara3D.Ids</PackageId>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ara3D.Ids</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Evaluates buildingSMART IDS 1.0 specifications over BIM Open Schema entities and parameters, as a verdict table.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- CDDL-1.0; parses IDS into an object model and carries the IDS value rules. No xbim IFC
         dependency. The reuse check is docs/proposals/ids-reuse.md in bim-open-toolkit. -->
    <PackageReference Include="Xbim.InformationSpecifications" Version="1.0.24" />
    <PackageReference Include="Ara3D.DataTable" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DepsRoot)bim-open-schema\src\Ara3D.BimOpenSchema\Ara3D.BimOpenSchema.csproj" />
    <ProjectReference Include="..\Ara3D.BimOpenSchema.ObjectModel\Ara3D.BimOpenSchema.ObjectModel.csproj" />
    <!-- TextNormalization: the unit spellings a descriptor's Units column may use. -->
    <ProjectReference Include="..\Ara3D.BimOpenSchema.DataModel\Ara3D.BimOpenSchema.DataModel.csproj" />
    <ProjectReference Include="..\Ara3D.Ifc.Conventions\Ara3D.Ifc.Conventions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ara3D.Ids.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
