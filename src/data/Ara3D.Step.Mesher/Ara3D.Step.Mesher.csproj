<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ara3D.Step.Mesher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Meshes the exact B-rep geometry of STEP AP203, AP214 and AP242 files in pure C#, through the generated AP242 types and Ara3D.MeshKernel.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ara3D.Step.Entities\Ara3D.Step.Entities.csproj" />
    <ProjectReference Include="..\Ara3D.MeshKernel\Ara3D.MeshKernel.csproj" />
    <PackageReference Include="Ara3D.Geometry" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.IO.StepParser" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Models" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Utils" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

</Project>
