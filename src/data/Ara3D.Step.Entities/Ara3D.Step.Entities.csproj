<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Ara3D.Step.Entities</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>The STEP (ISO 10303-21) entity model over a parsed document: StepModel, StepEntity, attribute readers, and the generated AP242 StepTypes. Portable: no native code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ara3D.IO.StepParser" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Utils" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

  <Import Project="..\Ara3D.StepTypes\Ara3D.StepTypes.projitems" Label="Shared" />
</Project>
