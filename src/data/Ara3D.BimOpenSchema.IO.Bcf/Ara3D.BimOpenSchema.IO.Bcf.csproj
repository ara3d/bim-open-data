<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Ara3D.BimOpenSchema.IO.Bcf</PackageId>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Writes BCF 3.0 (BIM Collaboration Format) issue files from a table of element GlobalIds, with viewpoints framed on BIM Open Schema geometry.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ara3D.DataTable" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DepsRoot)bim-open-schema\src\Ara3D.BimOpenSchema\Ara3D.BimOpenSchema.csproj" />
    <ProjectReference Include="..\Ara3D.BimOpenSchema.ObjectModel\Ara3D.BimOpenSchema.ObjectModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ara3D.BimOpenSchema.IO.Bcf.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
