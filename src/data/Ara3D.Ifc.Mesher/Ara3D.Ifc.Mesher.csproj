<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Ara3D.Ifc.Mesher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Description>Meshes IFC geometry from its STEP definitions in pure C#: swept solids, breps, tessellated sets, booleans, openings, and placements.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ara3D.IfcLoader\Ara3D.IfcLoader.csproj" />
    <PackageReference Include="Ara3D.Geometry" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.IO.StepParser" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Memory" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Models" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Utils" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Ara3D.IfcLoader" />
    <Using Include="Ara3D.IfcTypes" />
    <Using Include="Ara3D.IfcTypes.Ifc4" />
  </ItemGroup>

</Project>
