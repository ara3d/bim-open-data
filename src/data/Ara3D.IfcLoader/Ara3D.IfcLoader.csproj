<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Opens an IFC file: the STEP document and entity model from Ara3D.Ifc.Entities, plus web-ifc geometry (native, Windows x64) when asked for.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="web-ifc-library.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>web-ifc-library.dll</Link>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ara3D.IO.StepParser" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.Models" Version="$(Ara3DSdkVersion)" />
    <ProjectReference Include="..\Ara3D.Ifc.Entities\Ara3D.Ifc.Entities.csproj" />
  </ItemGroup>

</Project>
