<Project>
  <PropertyGroup>
    <!-- PlatonicVersion, PlatonicRoot, and the restore source are in Directory.Build.props, for every project. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Platonic.Core" Version="$(PlatonicVersion)" />
    <PackageReference Include="Platonic.Analyzers" Version="$(PlatonicVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
