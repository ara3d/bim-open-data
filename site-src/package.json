{
  "name": "bim-open-data-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The BOS explorer page: builds into ../site/explorer/ for GitHub Pages.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5280 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --outDir ../site --host 127.0.0.1 --port 5281 --strictPort",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hyparquet": "1.29.2",
    "hyparquet-compressors": "1.1.1",
    "jszip": "3.10.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
